BOT_TOKEN=123456:replace_me

# Публичный URL вашего домена (TLS завершает внешний nginx)
PUBLIC_BASE_URL=https://bot.example.com

# Секрет для URL вебхука (лучше отдельный, не BOT_TOKEN)
WEBHOOK_SECRET=replace_me_random

# Порт внутреннего nginx, который будет слушать на сервере (на localhost)
INTERNAL_NGINX_PORT=8080

