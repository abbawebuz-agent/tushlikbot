BOT_TOKEN=123456:replace_me

# Telegram user_id админов бота (через запятую, без пробелов).
# Только эти id получают доступ к /admin и связанным командам.
ADMINS=123456789,987654321

# Уникальное имя проекта для docker compose (чтобы 2 копии не конфликтовали контейнерами/volumes/networks)
COMPOSE_PROJECT_NAME=tushlikbot

# Публичный URL вашего домена (TLS завершает внешний nginx)
PUBLIC_BASE_URL=https://bot.example.com

# Секрет для URL вебхука (лучше отдельный, не BOT_TOKEN)
WEBHOOK_SECRET=replace_me_random

# Порт внутреннего nginx, который будет слушать на сервере (на localhost)
INTERNAL_NGINX_PORT=8080

# Postgres (прод)
POSTGRES_DB=tushlikbot
POSTGRES_USER=tushlikbot
POSTGRES_PASSWORD=change_me_strong

# Unfold admin branding
ADMIN_SITE_TITLE=Tushlikbot
ADMIN_SITE_HEADER=Tushlikbot Admin

# Django CSRF trusted origins (comma-separated)
CSRF_TRUSTED_ORIGINS=https://bot.example.com,http://localhost:8080

# --- Static files on S3-compatible storage (optional) ---
# Оставьте USE_S3_STATIC пустым/false, чтобы статика раздавалась локально через nginx.
# Включите (1/true), чтобы `collectstatic` заливал статику админки в S3-совместимый бакет.
# Пример ниже — под Cloudflare R2.
USE_S3_STATIC=true
# R2: Access Key ID / Secret из R2 API Token
AWS_ACCESS_KEY_ID=replace_me
AWS_SECRET_ACCESS_KEY=replace_me
# Имя бакета в R2
AWS_STORAGE_BUCKET_NAME=tushlikbot-static
# Endpoint для загрузки. R2: https://<account_id>.r2.cloudflarestorage.com
AWS_S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# Регион. R2 всегда "auto"
AWS_S3_REGION_NAME=auto
# ПУБЛИЧНЫЙ домен бакета, без схемы. ОБЯЗАТЕЛЬНО для R2: ссылки на статику идут сюда,
# а НЕ на r2.cloudflarestorage.com (тот только для загрузки, не публичный).
# Это либо managed-поддомен вида pub-<hash>.r2.dev, либо ваш Custom Domain (cdn.example.com).
AWS_S3_CUSTOM_DOMAIN=pub-<hash>.r2.dev
# Стиль адресации: virtual (bucket.host) или path (host/bucket). Для R2 можно оставить пустым.
AWS_S3_ADDRESSING_STYLE=
# Префикс внутри бакета для статики (по умолчанию "static")
AWS_STATIC_LOCATION=static
# ACL объектов. Для R2 ОСТАВЬТЕ ПУСТЫМ — R2 не использует ACL, публичность даёт публичный
# домен бакета. public-read нужен только провайдерам с ACL (классический Tigris/MinIO).
AWS_S3_DEFAULT_ACL=

